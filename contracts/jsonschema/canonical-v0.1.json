    "OutboxEntry": {
      "additionalProperties": false,
      "description": "Transactional handoff so exported state and recorded evidence cannot\ndiverge (docs/MASTER_ROADMAP.md `outbox` table).",
      "properties": {
        "destination": {
          "title": "Destination",
          "type": "string"
