    "ServiceRequest": {
      "$defs": {
        "BitemporalMeta": {
          "additionalProperties": false,
          "description": "Transaction-time envelope attached to every versioned canonical record.",
          "properties": {
            "corrects_version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The version number this record corrects, if any. None for the first version. A correction is a new version, never a mutation of the one it corrects.",
              "title": "Corrects Version"
            },
            "recorded_at": {
              "description": "When Milexium recorded this version (transaction time).",
              "format": "date-time",
              "title": "Recorded At",
              "type": "string"
            },
            "version": {
              "description": "Monotonic version number for this aggregate.",
              "minimum": 1,
              "title": "Version",
              "type": "integer"
            }
          },
          "required": [
            "version",
            "recorded_at"
          ],
          "title": "BitemporalMeta",
          "type": "object"
        },
        "RequestTimes": {
          "additionalProperties": false,
          "description": "The explicit time fields Program A requires for a service request.\n\nEvery field after `requested_at` is optional because, at any point in the\nrequest's lifecycle, most of them are not yet known -- that is the point\nof keeping them distinct instead of collapsing them into one \"when\" field.",
          "properties": {
            "actual_pickup_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The observed, ground-truth pickup time.",
              "title": "Actual Pickup At"
            },
            "negotiated_window_end": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "End of the pickup window agreed with the rider/agency.",
              "title": "Negotiated Window End"
            },
            "negotiated_window_start": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Start of the pickup window agreed with the rider/agency.",
              "title": "Negotiated Window Start"
            },
            "predicted_pickup_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A forecast's predicted pickup time, kept distinct from the scheduled time so a forecast can be scored against what was actually scheduled, and both against the actual outcome.",
              "title": "Predicted Pickup At"
            },
            "requested_at": {
              "description": "When the request was made (the fact that starts the aggregate).",
              "format": "date-time",
              "title": "Requested At",
              "type": "string"
            },
            "scheduled_pickup_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The pickup time a schedule run actually assigned.",
              "title": "Scheduled Pickup At"
            }
          },
          "required": [
            "requested_at"
          ],
          "title": "RequestTimes",
          "type": "object"
        },
        "ServiceRequestState": {
          "enum": [
            "requested",
            "negotiated",
            "scheduled",
            "in_progress",
            "completed",
            "denied",
            "cancelled",
            "no_show"
          ],
          "title": "ServiceRequestState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The immutable-per-version request aggregate. A correction produces a\nnew `ServiceRequest` with `meta.corrects_version` set and the same\n`request_id`, per architecture/decisions/0003-append-only-hash-chained-event-log.md.",
      "properties": {
        "dropoff_zone": {
          "title": "Dropoff Zone",
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/BitemporalMeta"
        },
        "mobility_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobility Device"
        },
        "pickup_zone": {
          "title": "Pickup Zone",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "rider_ref": {
          "description": "Tokenized rider reference. Never a raw name (blueprint 10 data minimization).",
          "title": "Rider Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ServiceRequestState"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "times": {
          "$ref": "#/$defs/RequestTimes"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "rider_ref",
        "pickup_zone",
        "dropoff_zone",
        "times",
        "status",
        "meta"
      ],
      "title": "ServiceRequest",
      "type": "object"
    },
    "StopTimeObservation": {
      "additionalProperties": false,
      "description": "A request-INDEPENDENT observation/prediction for one stop of one trip.\n\nThe second half of the operational entity family (ADR-0031). A GTFS-Realtime\n``TripUpdate`` ``stop_time_update`` -- which stop, in which trip, its schedule\nrelationship, and predicted arrival/departure with schedule deviations -- has\nno rider request either, so it also could only be squashed onto ``Outcome``\nbefore. Here it keys on its own ``observation_id`` and ``(tenant_id, trip_ref,\nstop_ref/stop_sequence, observed_at)``.\n\nPredicted vs observed are kept as separate fields on purpose: GTFS-Realtime\nsupplies *predictions* (``predicted_arrival_at`` and the delays); the\n``observed_arrival_at``/``observed_departure_at`` fields are the homes a later\nobserved-time source (AVL/TODS) will populate, and stay None for GTFS-RT --\nthe same predicted-vs-actual discipline ``ForecastVintage`` keeps, so a\nprediction is never mistaken for a record of what happened.",
      "properties": {
        "arrival_delay_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Delay Seconds"
        },
        "departure_delay_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Delay Seconds"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observed_arrival_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
