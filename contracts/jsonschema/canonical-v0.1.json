{
  "contract_version": "0.1.0",
  "entities": {
    "DecisionAlternative": {
      "$defs": {
        "ReasonCode": {
          "description": "Scheduling explanation reason codes. Never SHAP output or generated prose.",
          "enum": [
            "NO_ACCESSIBLE_CAPACITY",
            "PICKUP_WINDOW",
            "DROPOFF_WINDOW",
            "MAX_RIDE_TIME",
            "SHIFT_END",
            "PRECEDENCE",
            "SOLVER_TIMEOUT"
          ],
          "title": "ReasonCode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A candidate assignment considered (and, usually, rejected) during a\nschedule run -- required so \"why not the alternatives\" is answerable.",
      "properties": {
        "candidate_vehicle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Vehicle Id"
        },
        "failed_constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Failed Constraints",
          "type": "array"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "objective_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Delta"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schedule_run_id": {
          "title": "Schedule Run Id",
          "type": "string"
        }
      },
      "required": [
        "schedule_run_id",
        "request_id",
        "feasible"
      ],
      "title": "DecisionAlternative",
      "type": "object"
    },
