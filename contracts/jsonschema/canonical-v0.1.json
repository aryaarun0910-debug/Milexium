        "aggregate_type": {
          "title": "Aggregate Type",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/DecisionEventType"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
