# Copy to infra/compose/.env and set real values. .env is gitignored.
# Secrets are supplied externally, never baked into images (blueprint/10).
POSTGRES_USER=milexium_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=milexium_dev
MINIO_ROOT_USER=milexium_dev
MINIO_ROOT_PASSWORD=change-me-local-only

# The application role the code connects as (ADR-0052). POSTGRES_USER above is
# the CLUSTER SUPERUSER -- it holds rolbypassrls, and superuser bypass is checked
# BEFORE FORCE ROW LEVEL SECURITY, so connecting with it silently ignores every
# tenant policy. initdb/01-app-role.sh provisions this unprivileged LOGIN role
# (NOSUPERUSER, NOBYPASSRLS) and the stores prefer it. Keep the superuser
# credential for administration only.
MILEXIUM_APP_USER=milexium_app
MILEXIUM_APP_PASSWORD=change-me-local-only
