# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.vercel/
.pnpm-store/

# Rust
/target/
**/target/

# Data and models (large artifacts stay out of git)
*.pkl
*.zip
reference_agency/raw/
reference_agency/output/
realdata/raw_tlc/
realdata/raw_tlc_taxi/
realdata/output/
*.part

# Data estate (blueprint 17): raw/derived zones are large and reproducible,
# so they stay local-only. The catalog (data/catalog/) holds small manifests
# -- rights, checksums, inventories -- and IS committed as the governance
# record; the .gitkeep files preserve the empty zone structure.
data/raw/
data/quarantine/
data/canonical/
data/features/
data/networks/
data/standards/
data/simulation/
data/semantic/
data/experience/
data/benchmarks/
data/evidence/
data/scratch/
!data/**/.gitkeep

# Large aggregated panels and their per-month checkpoints: regenerate via
# the fetch scripts in realdata/. AAR (2.9 MB) and weather (small) stay
# committed as the compact, reproducible evidence; these do not.
realdata/panels/*_monthly/
realdata/panels/mta_bus_route_hour.csv.gz
realdata/panels/mta_subway_station_hour.csv.gz
realdata/panels/chicago_tnp_zone_hour.csv.gz
realdata/panels/nyc_fhvhv_zone_hour.parquet

# Generated artifact working state. Curated snapshots may still be committed.
artifacts/knowledge-graph/**/cache/
artifacts/knowledge-graph/**/.obsidian/
artifacts/audit/
# Golden-path demo output: regenerated with fresh UUIDs/timestamps each run
# (py -3 -m demo.golden_path). The demo code is committed; its output is not.
artifacts/golden-path/

# Environment
.env
.env.*
# ...but keep committed example templates (secrets go in the real .env)
!.env.example
!**/.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
outreach/drafts/
